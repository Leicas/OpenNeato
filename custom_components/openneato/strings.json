    "step": {
      "init": {
        "title": "Floorplan background",
        "description": "Optionally show a house floorplan image as the background of the cleaning map. Place a PNG/JPG on the Home Assistant machine and enter its absolute path, then calibrate origin, rotation and scale so the robot's path aligns with the walls.",
        "data": {
          "floorplan_image": "Floorplan image path (absolute)",
          "floorplan_origin_x": "Origin X (metres)",
          "floorplan_origin_y": "Origin Y (metres)",
          "floorplan_rotation": "Rotation (degrees)",
          "floorplan_scale": "Scale (pixels per metre)"
        },
        "data_description": {
          "floorplan_image": "Absolute path to a local PNG/JPG, e.g. /config/floorplan.png. Leave empty to disable the background and use the default dark map.",
          "floorplan_origin_x": "World X (metres, robot frame) where the floorplan image's bottom-left corner is anchored.",
          "floorplan_origin_y": "World Y (metres, robot frame) where the floorplan image's bottom-left corner is anchored.",
          "floorplan_rotation": "Rotate the floorplan around its anchor (degrees, clockwise).",
          "floorplan_scale": "How many floorplan-image pixels represent one metre."
        }
      }
    },
    "error": {
      "path_must_be_absolute": "The floorplan image path must be absolute (start with /).",
